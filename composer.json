{
    "name": "theunwindfront/nativephp-audio",
    "description": "Audio player plugin for NativePHP Mobile apps",
    "version": "1.5.0",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0|^4.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Theunwindfront\\Audio\\": "src/"
        },
        "files": [
            "polyfills/DispatchableFromNative.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Theunwindfront\\Audio\\AudioServiceProvider"
            ],
            "aliases": {
                "Audio": "Theunwindfront\\Audio\\Facades\\Audio"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Theunwindfront\\Audio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
